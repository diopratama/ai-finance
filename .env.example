# ==========================================
# AI-Finance Environment Configuration
# ==========================================

# 🐘 Database Configuration (Skenario B: Local Docker PostgreSQL)
# Saat dijalankan via Docker di laptop lokal, database otomatis aktif di container "db".
DATABASE_URL=postgresql://postgres:password@db:5432/ai_finance

# Jika ingin menghubungkan ke database server IP terpisah (Skenario A), ubah ke:
# DATABASE_URL=postgresql://user:password@103.xxx.xxx.xxx:5432/ai_finance

# Kredensial Database Container
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=ai_finance

# 🔐 Security & JWT Secrets
SECRET_KEY=ai-finance-super-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 👤 Initial Admin Account (Otomatis dibuat saat startup jika belum ada)
ADMIN_EMAIL=admin@aifinance.com
ADMIN_PASSWORD=AdminPassword123!

# 🤖 9router API (OpenAI-compatible AI Engine)
# Jika 9router berjalan di laptop host pada port 8080: http://host.docker.internal:8080/v1
# Atau jika menggunakan endpoint 9router cloud: https://api.9router.com/v1
LLM_BASE_URL=http://host.docker.internal:8080/v1
LLM_API_KEY=placeholder_key
LLM_MODEL_NAME=gpt-4o

# 💬 Telegram Bot Integration (Opsional, dari @BotFather)
TELEGRAM_BOT_TOKEN=

# 📱 Meta WhatsApp Cloud API Integration (Opsional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=ai-finance-wa-verify

# 🌐 Frontend & CORS
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8001
